# ==============================================================================
# TERRA-SR — Docker Build Ignore Rules (.dockerignore)
# Excludes sensitive secrets, large datasets, temporary caches, and local artifacts
# ==============================================================================

# Secrets & Environment Configuration
.env
.env.*
*.env
**/.env
**/*.env
!.env.example

# Version Control & Repository History
.git/
.github/
.gitignore

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Python Bytecode, Compilations & Test Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Large Datasets & Archives (Preserve data/processed/ for demo execution)
data/raw/
data/samples/
data/uploads/
*.jp2
*.npy
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
TERRA-SR_*.zip

# Runtime Outputs & Generated Deliverables
outputs/
scratch/
*.log
*.tmp
app/static/*.png
