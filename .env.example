# ==============================================================================
# TERRA-SR — Environment Configuration Template
# Problem Statement: SIH26142 (Deep Learning Based Super Resolution Mapping)
#
# NOTE: Copy this file to .env and supply your credentials if live satellite
# downloading is desired. If credentials are left blank or omitted, TERRA-SR
# automatically activates Demo Mode using pre-packaged Sentinel-2 imagery.
# ==============================================================================

# Copernicus Data Space Ecosystem (CDSE) OAuth2 Credentials (Optional)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Legacy / Alternative CDSE User Credentials (Optional)
CDSE_USERNAME=
CDSE_PASSWORD=

# Carto Positron Basemap API Key (Optional - Automatically falls back to OpenStreetMap)
CARTO_API_KEY=

# PlanetScope API Key for Multi-Sensor Validation (Optional)
PLANET_API_KEY=

# Server Port (Optional - Defaults to 8080 or platform $PORT)
PORT=8080
